# API Configuration - Production
VITE_API_BASE_URL=https://clownfish-app-b8ky4.ondigitalocean.app/api/v1
VITE_WS_URL=wss://clownfish-app-b8ky4.ondigitalocean.app

# API Configuration - Local Development (uncomment for local dev)
# VITE_API_BASE_URL=http://localhost:5000/api/v1
# VITE_WS_URL=ws://localhost:5000

# Backend Deployed URL
VITE_BACKEND_URL=https://clownfish-app-b8ky4.ondigitalocean.app

# Environment
VITE_NODE_ENV=development

# App Configuration
VITE_APP_NAME=ApexTrade Admin
VITE_APP_VERSION=1.0.0

# Features
VITE_ENABLE_WEBSOCKET=true
VITE_ENABLE_REAL_TIME_UPDATES=true
VITE_REFRESH_INTERVAL=30000

# Debug
VITE_DEBUG=false
VITE_LOG_LEVEL=info